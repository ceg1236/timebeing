# Copy this file to .env.local for local development.
# On Vercel, set these under Project Settings → Environment Variables instead.

# --- Google Sheets (bookings + capacity) ---
# One spreadsheet, forever — never changes per event. Each event gets its own
# Bookings tab, named after its slug and auto-created on its first booking.
# A shared "Config" tab holds capacity per date id across all events.
SPREADSHEET_ID=your_spreadsheet_id_here
# CONFIG_SHEET_NAME=Config       # optional override, defaults to "Config"

# Service account credentials — use ONE of these two:
# Local dev: path to a downloaded service-account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-credentials.json
# Vercel: paste the whole service-account JSON as a single line (no newlines)
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
# From the Stripe CLI (local) or Dashboard webhook settings (production)
STRIPE_WEBHOOK_SECRET=whsec_...

# Only needed if Stripe's redirect can't infer the site URL on its own (rare on Vercel)
# NEXT_PUBLIC_APP_URL=https://timebeing.example.com

# --- Resend (optional — booking confirmation emails) ---
# If either of these is missing, confirmation emails are silently skipped —
# the booking still counts, it just won't email the guest.
# RESEND_API_KEY=re_...
# RESEND_FROM=timebeing <hello@your-verified-domain.com>
